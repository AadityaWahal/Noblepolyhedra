# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Clerk Authentication Keys (Get yours free at https://clerk.com)
# VITE_CLERK_PUBLISHABLE_KEY: Used in React client and Vercel hosting
VITE_CLERK_PUBLISHABLE_KEY="pk_test_YOUR_CLERK_PUBLISHABLE_KEY"
# CLERK_SECRET_KEY: Used on serverless functions for secure token verification
CLERK_SECRET_KEY="sk_test_YOUR_CLERK_SECRET_KEY"

# MongoDB Database Connection (Get a free cluster at https://www.mongodb.com/atlas)
# Used by Vercel serverless functions (/api/user-data) to persist user bookmarks and favorites
MONGODB_URI="mongodb+srv://<username>:<password>@cluster0.mongodb.net/noble_polyhedra?retryWrites=true&w=majority"
